      (function () {
        var modeInput = document.getElementById("teacherModeInput");
        if (!modeInput) return;
        var selectBtn = document.getElementById("teacherModeSelectBtn");
        var addBtn = document.getElementById("teacherModeAddBtn");
        var selectPane = document.getElementById("teacherModeSelectPane");
        var addPane = document.getElementById("teacherModeAddPane");
        var selectedName = document.getElementById("teacherSelectedName");
        var fullName = document.getElementById("teacherFullNameInput");
        var payRate = document.getElementById("teacherPayRateInput");
        var schoolSelect = document.getElementById("teacherAssignedSchool");
        var groupSelect = document.getElementById("teacherAssignedGroup");
        var teacherPanel = document.querySelector(".admin-panel-teachers");
        var teacherCard = teacherPanel ? teacherPanel.querySelector(".teacher-form-card") : null;
        var teacherTableWrap = teacherPanel ? teacherPanel.querySelector(".admin-table-wrap") : null;

        function parseSchoolCodes(option) {
          if (!option) return [];
          var rawCodes = String(option.getAttribute("data-school-codes") || "").trim();
          if (!rawCodes) return [];
          return rawCodes
            .split(",")
            .map(function (value) { return String(value || "").trim().toLowerCase(); })
            .filter(Boolean);
        }

        function optionMatchesSchool(option, schoolCode) {
          if (!option || !option.value) return true;
          if (!schoolCode) return true;
          var optionSchoolCodes = parseSchoolCodes(option);
          if (!optionSchoolCodes.length) return true;
          return optionSchoolCodes.indexOf(schoolCode) !== -1;
        }

        function filterSelectBySchool(selectNode, schoolCode) {
          if (!selectNode) return;
          var currentValue = selectNode.value;
          var hasCurrentVisible = false;
          Array.prototype.forEach.call(selectNode.options, function (option) {
            if (!option.value) {
              option.hidden = false;
              return;
            }
            var visible = optionMatchesSchool(option, schoolCode);
            option.hidden = !visible;
            if (visible && option.value === currentValue) {
              hasCurrentVisible = true;
            }
          });
          if (currentValue && !hasCurrentVisible) {
            selectNode.value = "";
          }
        }

        function applySchoolFilters() {
          var schoolCode = schoolSelect
            ? String(schoolSelect.value || "").trim().toLowerCase()
            : "";
          filterSelectBySchool(selectedName, schoolCode);
          filterSelectBySchool(groupSelect, schoolCode);
        }

        function syncTeacherTableHeight() {
          if (!teacherCard || !teacherTableWrap) return;
          if (window.innerWidth < 641) {
            teacherTableWrap.style.removeProperty("height");
            return;
          }
          var cardHeight = Math.round(teacherCard.getBoundingClientRect().height || 0);
          if (cardHeight > 0) {
            teacherTableWrap.style.height = cardHeight + "px";
          }
        }

        function setMode(mode) {
          var isSelect = mode === "select";
          modeInput.value = isSelect ? "select" : "add";
          if (selectPane) selectPane.hidden = !isSelect;
          if (addPane) addPane.hidden = isSelect;
          if (selectedName) selectedName.required = isSelect;
          if (fullName) fullName.required = !isSelect;
          if (payRate) payRate.required = !isSelect;
          if (selectBtn) selectBtn.classList.toggle("is-active", isSelect);
          if (addBtn) addBtn.classList.toggle("is-active", !isSelect);
          syncTeacherTableHeight();
        }
        if (selectBtn) selectBtn.addEventListener("click", function () { setMode("select"); });
        if (addBtn) addBtn.addEventListener("click", function () { setMode("add"); });
        if (schoolSelect) schoolSelect.addEventListener("change", applySchoolFilters);
        window.addEventListener("resize", syncTeacherTableHeight);
        applySchoolFilters();
        setMode(modeInput.value === "add" ? "add" : "select");
        syncTeacherTableHeight();
      })();
      (function () {
        var searchInput = document.getElementById("adminStudentSearchInput");
        if (!searchInput) return;
        var rows = Array.from(document.querySelectorAll("tr[data-student-row]"));
        var emptyRow = document.getElementById("adminStudentsNoResultsRow");
        if (!rows.length) return;
        var applyFilter = function () {
          var query = String(searchInput.value || "").trim().toLowerCase();
          var visibleCount = 0;
          rows.forEach(function (row) {
            var rowText = String(row.getAttribute("data-student-search") || "").toLowerCase();
            var isVisible = !query || rowText.includes(query);
            row.hidden = !isVisible;
            if (isVisible) visibleCount += 1;
          });
          if (emptyRow) emptyRow.hidden = visibleCount > 0;
        };
        searchInput.addEventListener("input", applyFilter, { passive: true });
        applyFilter();
      })();
      (function () {
        var resourceForm = document.querySelector("form.admin-resource-form");
        if (!resourceForm) return;
        var submitButton = resourceForm.querySelector("button[type='submit']");
        var loadingState = resourceForm.querySelector("[data-resource-loading-state]");
        var loadingTrack = resourceForm.querySelector(".admin-resource-loading-track");
        var loadingBar = resourceForm.querySelector("[data-resource-loading-bar]");
        var loadingText = resourceForm.querySelector("[data-resource-loading-text]");
        var fileInput = resourceForm.querySelector("input[name='resource_file']");
        var uploadIdInput = resourceForm.querySelector("input[name='upload_id']");
        var activeRequest = null;
        var activeSocket = null;
        var highestProgressPercent = 0;

        function clampPercent(value) {
          if (!isFinite(value)) return 0;
          if (value < 0) return 0;
          if (value > 100) return 100;
          return value;
        }

        function formatEta(seconds) {
          var totalSeconds = Math.max(0, Math.round(seconds));
          if (totalSeconds < 60) return totalSeconds + "s";
          var minutes = Math.floor(totalSeconds / 60);
          var remainder = totalSeconds % 60;
          if (minutes < 60) {
            return remainder > 0 ? (minutes + "m " + remainder + "s") : (minutes + "m");
          }
          var hours = Math.floor(minutes / 60);
          var remainingMinutes = minutes % 60;
          if (remainingMinutes > 0) return hours + "h " + remainingMinutes + "m";
          return hours + "h";
        }

        function setLoadingMessage(text) {
          if (!loadingText) return;
          loadingText.textContent = String(text || "");
        }

        function setProgress(percent, etaSeconds) {
          var safePercent = clampPercent(percent);
          if (loadingBar) {
            loadingBar.style.width = safePercent.toFixed(1) + "%";
          }
          if (loadingTrack) {
            loadingTrack.setAttribute("aria-valuenow", String(Math.round(safePercent)));
          }
          if (etaSeconds != null && isFinite(etaSeconds) && etaSeconds >= 0) {
            setLoadingMessage(
              "Uploading... " +
              Math.round(safePercent) +
              "% · ~" +
              formatEta(etaSeconds) +
              " left"
            );
            return;
          }
          setLoadingMessage("Uploading... " + Math.round(safePercent) + "%");
        }

        function setSubmittingState(isSubmitting) {
          if (isSubmitting) {
            resourceForm.setAttribute("data-submitting", "1");
            resourceForm.classList.add("is-submitting");
            if (loadingState) {
              loadingState.hidden = false;
              loadingState.setAttribute("aria-hidden", "false");
            }
            if (submitButton) {
              submitButton.disabled = true;
              submitButton.textContent = "Uploading...";
            }
            return;
          }

          resourceForm.removeAttribute("data-submitting");
          resourceForm.classList.remove("is-submitting");
          if (loadingState) {
            loadingState.hidden = true;
            loadingState.setAttribute("aria-hidden", "true");
          }
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.textContent = "Save Resource";
          }
        }

        function showError(message) {
          closeSocket();
          setSubmittingState(false);
          if (loadingState) {
            loadingState.hidden = false;
            loadingState.setAttribute("aria-hidden", "false");
          }
          if (loadingBar) {
            loadingBar.style.width = "0%";
          }
          if (loadingTrack) {
            loadingTrack.setAttribute("aria-valuenow", "0");
          }
          setLoadingMessage(message || "Upload failed. Please try again.");
        }

        function ensureUploadIdInput() {
          if (uploadIdInput) return uploadIdInput;
          uploadIdInput = document.createElement("input");
          uploadIdInput.type = "hidden";
          uploadIdInput.name = "upload_id";
          resourceForm.appendChild(uploadIdInput);
          return uploadIdInput;
        }

        function createUploadId() {
          if (window.crypto && typeof window.crypto.randomUUID === "function") {
            return String(window.crypto.randomUUID());
          }
          return (
            "upload-" +
            Date.now().toString(36) +
            "-" +
            Math.random().toString(36).slice(2, 12)
          );
        }

        function closeSocket() {
          if (!activeSocket) return;
          try {
            activeSocket.close();
          } catch (_error) {}
          activeSocket = null;
        }

        function buildSocketUrl(uploadId) {
          var protocol = window.location.protocol === "https:" ? "wss://" : "ws://";
          var host = String(window.location.host || "").trim();
          if (!host) return "";
          return (
            protocol +
            host +
            "/ws/resource-upload/" +
            encodeURIComponent(String(uploadId || "").trim())
          );
        }

        function updateProgressFromServer(payload) {
          if (!payload || typeof payload !== "object") return;

          var serverPercent = Number(payload.percent);
          if (isFinite(serverPercent)) {
            highestProgressPercent = Math.max(highestProgressPercent, serverPercent);
            setProgress(highestProgressPercent, payload.eta_seconds);
          }

          var serverMessage = String(payload.message || "").trim();
          if (serverMessage) {
            setLoadingMessage(serverMessage);
          }

          if (payload.error) {
            showError(serverMessage || "Upload failed. Please try again.");
            return;
          }

          if (payload.done) {
            highestProgressPercent = 100;
            setProgress(100, null);
            closeSocket();
          }
        }

        function connectSocket(uploadId) {
          closeSocket();
          if (!("WebSocket" in window)) return;

          var socketUrl = buildSocketUrl(uploadId);
          if (!socketUrl) return;

          try {
            activeSocket = new WebSocket(socketUrl);
          } catch (_error) {
            activeSocket = null;
            return;
          }

          activeSocket.addEventListener("message", function (messageEvent) {
            var payload = null;
            try {
              payload = JSON.parse(String(messageEvent.data || ""));
            } catch (_error) {
              return;
            }

            if (payload && payload.type === "heartbeat") {
              return;
            }
            updateProgressFromServer(payload);
          });

          activeSocket.addEventListener("error", function () {
            return;
          });

          activeSocket.addEventListener("close", function () {
            activeSocket = null;
          });
        }

        resourceForm.addEventListener("submit", function (event) {
          if (resourceForm.getAttribute("data-submitting") === "1") {
            event.preventDefault();
            return;
          }
          event.preventDefault();

          var hasUploadFile = Boolean(
            fileInput &&
            fileInput.files &&
            fileInput.files.length > 0 &&
            Number(fileInput.files[0].size || 0) > 0
          );

          var uploadId = createUploadId();
          ensureUploadIdInput().value = uploadId;

          highestProgressPercent = 0;
          closeSocket();
          connectSocket(uploadId);

          setSubmittingState(true);
          if (loadingBar) {
            loadingBar.style.width = "0%";
          }
          if (loadingTrack) {
            loadingTrack.setAttribute("aria-valuenow", "0");
          }
          if (hasUploadFile) {
            setLoadingMessage("Starting upload...");
          } else {
            setLoadingMessage("Saving resource...");
          }

          var xhr = new XMLHttpRequest();
          activeRequest = xhr;
          var startedAt = Date.now();

          xhr.open(
            String(resourceForm.method || "POST").toUpperCase(),
            resourceForm.action,
            true
          );
          xhr.setRequestHeader("X-Requested-With", "XMLHttpRequest");

          xhr.upload.addEventListener("progress", function (progressEvent) {
            if (!hasUploadFile) return;
            if (!progressEvent.lengthComputable || progressEvent.total <= 0) {
              setLoadingMessage("Uploading...");
              return;
            }
            var percent = (progressEvent.loaded / progressEvent.total) * 80;
            var elapsedSeconds = (Date.now() - startedAt) / 1000;
            var bytesPerSecond = elapsedSeconds > 0
              ? progressEvent.loaded / elapsedSeconds
              : 0;
            var etaSeconds = bytesPerSecond > 0
              ? (progressEvent.total - progressEvent.loaded) / bytesPerSecond
              : null;
            if (percent > highestProgressPercent) {
              highestProgressPercent = percent;
              setProgress(highestProgressPercent, etaSeconds);
            }
          });

          xhr.addEventListener("load", function () {
            activeRequest = null;
            if (xhr.status >= 200 && xhr.status < 400) {
              highestProgressPercent = 100;
              setProgress(100, null);
              closeSocket();
              var responseHtml = String(xhr.responseText || "");
              if (!responseHtml) {
                window.location.reload();
                return;
              }
              document.open("text/html", "replace");
              document.write(responseHtml);
              document.close();
              return;
            }
            showError("Upload failed (" + xhr.status + "). Please try again.");
          });

          xhr.addEventListener("error", function () {
            activeRequest = null;
            showError("Network error during upload. Please try again.");
          });

          xhr.addEventListener("abort", function () {
            activeRequest = null;
            showError("Upload was cancelled.");
          });

          var formData = new FormData(resourceForm);
          xhr.send(formData);
        });

        window.addEventListener("beforeunload", function () {
          closeSocket();
          if (activeRequest && resourceForm.getAttribute("data-submitting") === "1") {
            try {
              activeRequest.abort();
            } catch (_error) {}
          }
        });
      })();
      (function () {
        var rows = Array.from(document.querySelectorAll("[data-resource-type-row]"));
        if (!rows.length) return;

        function setEditing(row, isEditing) {
          var display = row.querySelector("[data-resource-type-display]");
          var renameForm = row.querySelector("[data-resource-type-rename-form]");
          var input = row.querySelector("[data-resource-type-input]");
          var editBtn = row.querySelector("[data-resource-type-edit-btn]");
          var deleteForm = row.querySelector("[data-resource-type-delete-form]");
          var saveBtn = row.querySelector("[data-resource-type-save-btn]");
          var cancelBtn = row.querySelector("[data-resource-type-cancel-btn]");
          var originalValue = row.getAttribute("data-resource-type-original") || "";

          row.classList.toggle("is-editing", isEditing);
          if (display) display.hidden = isEditing;
          if (renameForm) renameForm.hidden = !isEditing;
          if (editBtn) editBtn.hidden = isEditing;
          if (deleteForm) deleteForm.hidden = isEditing;
          if (saveBtn) saveBtn.hidden = !isEditing;
          if (cancelBtn) cancelBtn.hidden = !isEditing;

          if (!input) return;
          if (isEditing) {
            input.value = originalValue;
            window.setTimeout(function () {
              input.focus();
              input.select();
            }, 0);
            return;
          }
          input.value = originalValue;
        }

        function closeOtherRows(activeRow) {
          rows.forEach(function (row) {
            if (row === activeRow) return;
            setEditing(row, false);
          });
        }

        rows.forEach(function (row) {
          var display = row.querySelector("[data-resource-type-display]");
          var renameForm = row.querySelector("[data-resource-type-rename-form]");
          var input = row.querySelector("[data-resource-type-input]");
          var editBtn = row.querySelector("[data-resource-type-edit-btn]");
          var cancelBtn = row.querySelector("[data-resource-type-cancel-btn]");
          var saveBtn = row.querySelector("[data-resource-type-save-btn]");
          var originalValue = display ? String(display.textContent || "").trim() : "";

          row.setAttribute("data-resource-type-original", originalValue);
          setEditing(row, false);

          if (editBtn) {
            editBtn.addEventListener("click", function () {
              closeOtherRows(row);
              setEditing(row, true);
            });
          }

          if (cancelBtn) {
            cancelBtn.addEventListener("click", function () {
              setEditing(row, false);
            });
          }

          if (input) {
            input.addEventListener("keydown", function (event) {
              if (event.key === "Escape") {
                event.preventDefault();
                setEditing(row, false);
              }
            });
          }

          if (renameForm) {
            renameForm.addEventListener("submit", function () {
              if (saveBtn) saveBtn.disabled = true;
              if (cancelBtn) cancelBtn.disabled = true;
            });
          }
        });
      })();
