{
    auto_https off
}

:{$PORT:8080} {
    encode zstd gzip

    handle /health/ready {
        header Content-Type application/json
        respond `{"status":"ready","service":"lms-frontend"}` 200
    }

    @frontend_entry path \
        /static/react/app.js \
        /static/react/app.css \
        /static/react/manifest.json \
        /static/react/index.html
    handle @frontend_entry {
        root * /srv
        header Cache-Control "no-cache"
        file_server
    }

    handle /static/react/* {
        root * /srv
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        reverse_proxy {$BACKEND_INTERNAL_URL}
    }
}
