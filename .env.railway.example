# Railway service variables for the MSI School web service.
# Do not commit real secrets here. Set these in Railway Variables.

# Runtime
RUN_MODE=web
APP_ENV=production
WEB_HOST=0.0.0.0
PORT=${{RAILWAY_PORT}}

# Security
APP_SECRET_KEY=replace-with-python-secrets-token-hex-32
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=1

# Database
# Prefer a Railway reference variable pointing at your Postgres service.
DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_POOL_TIMEOUT=10

# Optional rate-limit storage. If you add Railway Redis, point this at it.
# REDIS_URL=${{Redis.REDIS_URL}}

# Telegram / Mini App
BOT_TOKEN=replace-with-telegram-bot-token
MINI_APP_URL=https://replace-after-railway-domain
WEBAPP_INIT_DATA_TTL=3600

# Owner/admin seed. Required only when creating/rotating owner login.
OWNER_ADMIN_LOGIN=staff280902
OWNER_ADMIN_PASSWORD=replace-with-strong-password

# Demo auth must be disabled for public testing unless you intentionally want
# anyone with the URL to enter without login.
DEMO_AUTH_ENABLED=0

# Resource upload storage. Keep disabled unless Cloudflare R2 is configured.
R2_ENABLED=0
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=

# Caches
GROUP_CACHE_TTL_SECONDS=600
RATING_CACHE_TTL_SECONDS=60
RATING_CACHE_MAX_ENTRIES=128
STUDENT_METADATA_CACHE_SECONDS=30
STUDENT_PANEL_CONTEXT_CACHE_SECONDS=30
ADMIN_PAGE_CONTEXT_CACHE_SECONDS=15
